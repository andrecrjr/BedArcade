{
  "name": "bedarcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e": "npm run build:e2e && playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.7.3",
    "wxt": "^0.20.0"
  }
}
