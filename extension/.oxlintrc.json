{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "chrome": "readonly",
    "defineContentScript": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    ".output/**",
    ".wxt/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
