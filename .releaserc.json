{
  "branches": ["main"],
  "tagFormat": "desktop-v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "desktop/dist/GamepadDesktop-Windows-x64.zip",
            "label": "Gamepad Desktop for Windows x64"
          },
          {
            "path": "desktop/dist/GamepadDesktop-Linux-x64.tar.gz",
            "label": "Gamepad Desktop for Linux x64"
          },
          {
            "path": "CHANGELOG.md",
            "label": "Gamepad Desktop changelog"
          }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ]
  ]
}
